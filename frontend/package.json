{
  "name": "realworld-conduit-vue",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "marked": "18.1.2",
    "pinia": "3.0.4",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.3",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}

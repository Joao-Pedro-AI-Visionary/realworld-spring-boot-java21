# URL base da API REST do backend, ja com o prefixo /api e SEM barra final.
# Exemplo: VITE_API_URL=https://seu-backend.exemplo.com/api
# Se ficar vazia, o app entra automaticamente no modo demo.
VITE_API_URL=

# true = usa o backend mockado no navegador (src/api/demo), com dados em localStorage.
# Login demo: demo@conduit.dev / demo1234
VITE_DEMO_MODE=true

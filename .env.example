# Copy to .env and fill in. Never commit .env.
# HS512 signing key, at least 64 characters. Generate one with:
#   openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# Comma-separated allowed CORS origins; patterns like https://*.vercel.app are accepted.
# Leave unset (or "*") to allow any origin in local development.
CORS_ALLOWED_ORIGINS=
